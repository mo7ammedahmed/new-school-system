APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_WORKER_STALE_MINUTES=10
QUEUE_BACKLOG_THRESHOLD=100
QUEUE_FAILED_THRESHOLD=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

NOTIFICATION_DELIVERY_FAILURE_THRESHOLD=10
NOTIFICATION_DELIVERY_QUEUE_THRESHOLD=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
REGISTRATION_ENABLED=false

# School calendar module
SCHEDULE_COORDINATORS_CAN_PUBLISH=false
SCHEDULE_MAX_EXAMS_PER_DAY_PER_SECTION=1
SCHEDULE_TEACHER_MAX_PERIODS_PER_DAY=
SCHEDULE_TEACHER_MAX_PERIODS_PER_WEEK=

# ---------------------------------------------------------------------------
# Production-like configuration
# ---------------------------------------------------------------------------
# `php artisan app:release-check --strict` promotes every non-critical warning
# to a failure. To reach a zero-failure result the following values are the
# minimum required. Uncomment and fill in on the target environment only; never
# commit a real secret.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...                       # php artisan key:generate --show
# APP_URL=https://school.example.sa        # must start with https://
# QUEUE_CONNECTION=database                 # must not be sync or null
# MAIL_MAILER=smtp                         # must not be log or array
# MAIL_HOST=smtp.example.sa
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@example.sa
# MAIL_FROM_NAME="${APP_NAME}"
# SESSION_DRIVER=database                  # shared across all instances
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# STRIPE_SECRET=sk_live_...                # pair both values, or leave both empty
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENTS_ENABLED=true
#
# On a developer machine the strict check is expected to report three failures —
# APP_ENV is not production, APP_URL is not HTTPS, and the mail transport is
# log/array. Those three are configuration-only failures and are tolerated by
# `RELEASE_MODE=local`; `RELEASE_MODE=ci` treats them as hard failures.
